# Copie ce fichier en ".env" (jamais versionné) et remplis les valeurs.

# Token Meta longue durée.
# Permissions LECTURE SEULE recommandées :
#   pages_read_engagement, pages_show_list, read_insights,
#   instagram_basic, instagram_manage_insights
META_ACCESS_TOKEN=

# Token Threads (optionnel). À défaut, META_ACCESS_TOKEN est utilisé.
THREADS_ACCESS_TOKEN=

# Garde-fou. Laisse vide ou "false" pour interdire toute publication/suppression.
# Passe à "true" seulement quand tu veux publier — nécessite aussi les permissions
# pages_manage_posts et instagram_content_publish sur le token.
META_ENABLE_WRITES=false
